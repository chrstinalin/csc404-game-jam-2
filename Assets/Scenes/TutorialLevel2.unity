  m_Script: {fileID: 11500000, guid: 4efbb9c03109d4d41b864f3a4e01452d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  textUI: {fileID: 2106952589}
  lines:
  - '> Initializing TRAINING_MODULE_2...

    > [SCAN] Lasers are deadly. Do not
    touch them.

    > [DIRECTIVE] Walk around the laser.'
  - '> [INFO] After the Y2K bug, Turrets and Patrols have become the enemy.

    >
    [INFO] Peanut cannot defend herself, but Dreadnought Killer can attack.

    >
    [DIRECTIVE] Activate LOCK ON MODE'
  - '> [INFO] In LOCK ON MODE, hover the marker over a target and press B to select
    it.

    > [INFO] Selecting enemies will command Dreadnought Killer to attack
    it.

    > [DIRECTIVE] Destroy the turret.'
  - '> [INFO] Peanut can pick up and hand over scrap metal dropped by enemies to
    heal Dreadnought Killer

    > [DIRECTIVE] Destroy the cracked wall and exit
    the room to complete the tutorial.'
  typeSpeed: 0.02
