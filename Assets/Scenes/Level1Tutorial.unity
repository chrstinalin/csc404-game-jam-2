  m_Name: 
  m_EditorClassIdentifier: '::'
  textUI: {fileID: 2134982947}
  lines:
  - '> Initializing TRAINING_MODULE_1...

    > [SCAN] Door is locked.

    > [DIRECTIVE]
    Press Y to control Peanut.'
  - '> Squeak()

    > [INFO] Levers start the flow of electricity.

    > [INFO]
    Only Peanut can pull levers.

    > [DIRECTIVE] Pull the lever to open the door.'
  - '> [SCAN] Door.unlocked == TRUE.

    > [INFO] Electricity can trigger any connected
    device.

    > [DIRECTIVE] Walk through the door.'
  - '> [SCAN] EXIT door is locked.

    > [INFO] Buttons start electricity when pressed.

    >
    [INFO] Only Dreadnought Killer can move metal crates.

    > [DIRECTIVE] Get
    BOTH Dreadnought Killer and Peanut to the EXIT to progress.'
  typeSpeed: 0.02
